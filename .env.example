# Copy this file to .env and fill in your own values. Never commit .env.
# In AWS the same names are set at deploy time: [secret] ones from Secrets Manager (olist/prod),
# the others from Parameter Store (/olist/prod/NAME). See docs/DEPLOY_AWS.md.

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password           # [secret]
MYSQL_DATABASE=olist
# Encrypted, verified connection (required by RDS): path of the CA bundle. Empty = no TLS (local MySQL).
# In the container image the RDS bundle is at /etc/ssl/rds/global-bundle.pem
MYSQL_SSL_CA=

# Least-privilege MySQL user the AI tools run as. `python -m ai.db_user` creates it
# (and generates a password here if this is empty).
AGENT_MYSQL_USER=olist_agent
AGENT_MYSQL_PASSWORD=                         # [secret]
# The seller and admin assistants have their own users (python -m ai.seller.db_user / ai.admin.db_user)
SELLER_AGENT_MYSQL_USER=olist_seller_agent
SELLER_AGENT_MYSQL_PASSWORD=                  # [secret]
ADMIN_AGENT_MYSQL_USER=olist_admin_agent
ADMIN_AGENT_MYSQL_PASSWORD=                   # [secret]
# Where the app connects from, for those users (MySQL host patterns). Locally this machine; in AWS: %
AGENT_DB_HOSTS=localhost,127.0.0.1

# Admin account created by seed_users.py (a random password is generated if empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=                               # [secret]

# Default passwords for seeded accounts (users are asked to change them on first login)
CUSTOMER_DEFAULT_PASSWORD=customer123         # [secret] in AWS
SELLER_DEFAULT_PASSWORD=seller123             # [secret] in AWS

# Signs login sessions; set any long random string so sessions survive restarts
JWT_SECRET=                                   # [secret]; required when APP_ENV=production

# Quick-login buttons on the sign-in page (testing only; set to false before real use)
DEMO_LOGIN=true

# AI assistant. Empty AI_MODEL = placeholder replies. Examples:
#   AI_MODEL=anthropic:claude-sonnet-5-5   (needs ANTHROPIC_API_KEY)
#   AI_MODEL=google:gemini-3.5-flash-lite   (needs GOOGLE_API_KEY)
# A per-role model in ai_settings.model_by_role overrides this.
AI_MODEL=
# Disable the local sentence-transformer model in production. Production installs only
# requirements.txt, which does not include torch or sentence-transformers.
AI_LOCAL_EMBEDDINGS_ENABLED=true
# ANTHROPIC_API_KEY=                          # [secret]
# GOOGLE_API_KEY=                             # [secret]

# Deployment (AWS). APP_ENV=production refuses to start without JWT_SECRET. COOKIE_SECURE=true sends the
# login cookie over HTTPS only (set it when the site is served over HTTPS). APP_VERSION is set by the
# image build (the git commit) and shown by /api/health.
APP_ENV=development
COOKIE_SECURE=false
