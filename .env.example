# Copy this file to .env and fill in your own values. Never commit .env.

# MySQL connection
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=olist

# Admin account created by seed_users.py (a random password is generated if empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Default passwords for seeded accounts (users are asked to change them on first login)
CUSTOMER_DEFAULT_PASSWORD=customer123
SELLER_DEFAULT_PASSWORD=seller123

# Signs login sessions; set any long random string so sessions survive restarts
JWT_SECRET=

# Quick-login buttons on the sign-in page (testing only; set to false before real use)
DEMO_LOGIN=true

# AI assistant (not connected yet)
# ANTHROPIC_API_KEY=
